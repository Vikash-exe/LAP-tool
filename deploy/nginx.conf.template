# The front door of the dashboard: HTTPS and the proxy to the app container. The sign-in itself (page, passwords,
# sessions) is done by the app. nginx fills in ${LAP_HTTPS_PORT} from the environment when the container starts.

# Password guessing: at most 20 sign-in attempts a minute per address (the app also blocks an address after 8 failures).
limit_req_zone $binary_remote_addr zone=lap_login:5m rate=20r/m;

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/lap.crt;
    ssl_certificate_key /etc/nginx/certs/lap.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:LAP:5m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Area files and DXFs go up to MAX_UPLOAD_MB (200 by default); nginx's own limit must be above it.
    client_max_body_size 300m;

    proxy_http_version 1.1;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Uploads and downloads are streamed, not held in nginx; a search that loads a big state can take minutes.
    proxy_request_buffering off;
    proxy_buffering         off;
    proxy_connect_timeout   10s;
    proxy_send_timeout      3600s;
    proxy_read_timeout      3600s;

    location = /api/login {
        limit_req zone=lap_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://lap:8010;
    }

    location / {
        proxy_pass http://lap:8010;
    }
}

# The old address (http, port 8010) sends people to the secure one.
server {
    listen 8010;
    server_name _;
    return 301 https://$host:${LAP_HTTPS_PORT}$request_uri;
}
