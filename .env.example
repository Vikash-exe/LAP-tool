# Copy to .env (next to compose.yaml) and fill in. .env is not committed.
# The database the app reads (the password is read from ~/.pgpass, never stored here).
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
# The user that owns the project folder: output of `id -u` and `id -g` (so results and ~/.pgpass keep the right ownership).
LAP_UID=1000
LAP_GID=1000
# Optional
# LAP_HTTPS_PORT=8443
# LAP_HTTP_PORT=8010
# MAX_UPLOAD_MB=200
